<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasySave.ViewModels"
        x:Class="EasySave.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="EasySave" Width="440" Height="700"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24" RowDefinitions="Auto,Auto,16,Auto,Auto,16,Auto,Auto,16,1,16,Auto,*">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="EasySave" FontWeight="Bold" FontSize="14" LetterSpacing="2"/>
            <TextBlock Text="{Binding StatusText}" Classes="secondary" Margin="12,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,140,Auto" Margin="0,16,0,0">
            <ComboBox Grid.Column="0" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                            DisplayMemberBinding="{Binding Name}" Height="34" Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"/>
            <TextBox Grid.Column="1" Watermark="New game name" Text="{Binding NewGameName}" Height="34" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="+ Add" Command="{Binding AddGameCommand}" Height="34"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="UPLOAD" Classes="secondary" FontWeight="Bold" LetterSpacing="1"/>
                <Button Content="Pick Save Files" Command="{Binding PickFilesCommand}" HorizontalAlignment="Stretch"/>
                <ItemsControl ItemsSource="{Binding SelectedFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="secondary mono" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Upload" Command="{Binding UploadCommand}" Classes="primary" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="DOWNLOAD" Classes="secondary" FontWeight="Bold" LetterSpacing="1"/>
                <Button Content="Pick Destination Folder" Command="{Binding PickDownloadFolderCommand}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding DownloadDestinationPath}" Classes="secondary mono" TextTrimming="CharacterEllipsis"/>
                <Button Content="Download Latest" Command="{Binding DownloadLatestCommand}" Classes="primary" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Rectangle Grid.Row="9" Height="1" Fill="{StaticResource BorderBrush2}"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="RECENT SAVES" FontWeight="Bold" FontSize="12" LetterSpacing="1" Classes="secondary"/>
            <Ellipse Width="8" Height="8" Fill="{Binding SyncStatusColor}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SyncStatusText}" Classes="secondary" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="12" Margin="0,10,0,0" MaxHeight="150">
            <ItemsControl ItemsSource="{Binding RecentSaves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="0,0,0,6" Padding="0">
                            <Grid ColumnDefinitions="4,*">
                                <Rectangle Grid.Column="0" Fill="{StaticResource AccentBrush}"/>
                                <StackPanel Grid.Column="1" Margin="12,10" Spacing="2">
                                    <TextBlock Text="{Binding Name}" Classes="mono" FontSize="12"/>
                                    <TextBlock Text="{Binding CreatedTime}" Classes="secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</Window>